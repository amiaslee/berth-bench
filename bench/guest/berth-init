#!/bin/sh
# 客机 PID 1：挂好系统目录，根盘只读，可写的都放内存；然后在 vsock 52 口等宿主发命令。
# 这台机器"每次从干净系统起"：根盘是所有机器共用的只读镜像，这个人的盘由宿主让挂到 /work。
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOME=/root LANG=C.UTF-8
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777 tmpfs /dev/shm
mount -t tmpfs -o mode=0755 tmpfs /run
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t tmpfs -o mode=1777 tmpfs /var/tmp
mount -t tmpfs -o mode=0700 tmpfs /root
mount -t cgroup2 cgroup2 /sys/fs/cgroup 2>/dev/null
hostname bench
ip link set lo up
for a in $(cat /proc/cmdline); do
  case "$a" in
    berth.ip=*) ip addr add "${a#berth.ip=}" dev eth0 && ip link set eth0 up ;;
  esac
done
exec socat VSOCK-LISTEN:52,fork,reuseaddr EXEC:/bin/sh,stderr
